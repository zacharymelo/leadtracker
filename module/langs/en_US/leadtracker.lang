# Module identity
Module500121Name = Lead Tracker
Module500121Desc = Visual pipeline tracker and automation engine for Dolibarr opportunities

# UI
LeadtrackerTitle = Lead pipeline
LeadtrackerNotApplicable = Not applicable

# Setup page
LeadtrackerSetup = Lead Tracker setup
LeadtrackerSetupPage = Configure auto-advance conditions, the opportunity filter, and display options.

# Auto-advance conditions section
LeadtrackerAutoSectionTitle = Auto-advance conditions
LeadtrackerAutoSectionHelp = Check the conditions that should trigger automatic stage advancement. Any one matched condition advances the deal (OR logic). Stage order is managed in Home > Setup > Dictionary > Lead status.
LeadtrackerNoStages = No active pipeline stages found.
LeadtrackerGoToDictionary = Set up lead statuses →

# Condition types — full labels (used in tooltips)
LeadtrackerConditionHasContact = Has outbound contact (call, email, meeting)
LeadtrackerConditionHasProposal = Has at least one proposal
LeadtrackerConditionHasSignedProposal = Has a signed / accepted proposal
LeadtrackerConditionHasOrder = Has a validated order
LeadtrackerConditionHasInvoice = Has a validated invoice
LeadtrackerConditionManualOnly = Manual only (never auto-advance)

# Condition types — short column headers for the matrix table
LeadtrackerConditionContactShort = Contact
LeadtrackerConditionProposalShort = Proposal
LeadtrackerConditionSignedShort = Signed
LeadtrackerConditionOrderShort = Order
LeadtrackerConditionInvoiceShort = Invoice
LeadtrackerConditionManualShort = Manual

# Data sync section
LeadtrackerDataSyncTitle = Data sync
LeadtrackerAmountMode = Lead amount source
LeadtrackerAmountModeManual = Manual (never auto-update)
LeadtrackerAmountModeAuto = Auto — LTV hierarchy
LeadtrackerAmountModeHelp = Auto mode tracks the closest-to-cash figure available: open proposals are averaged until one is accepted, accepted proposals are superseded by validated orders, and orders are superseded by invoices. Multiple invoices and orders accumulate as a running lifetime total.
LeadtrackerAmountExtrafield = Baseline extrafield
LeadtrackerAmountExtrafieldHelp = Attribute code of a numeric project extrafield to use as the initial lead value when no proposals, orders, or invoices exist yet (e.g. an estimate captured at lead intake). Leave empty to disable.
LeadtrackerPercentMode = Probability percentage
LeadtrackerPercentModeManual = Manual (never auto-update)
LeadtrackerPercentModeStageDefault = Auto — follow stage default
LeadtrackerPercentModeHelp = Stage default reads the percentage configured in Home > Setup > Dictionary > Lead status and writes it to the project whenever the stage advances.

# Opportunity filter section
LeadtrackerFilterSectionTitle = Opportunity filter
LeadtrackerFilterUsageNote = Only projects with "Follow opportunity" checked are ever shown in the tracker — that is the primary gate. The category filter below narrows further within that set.
LeadtrackerFilterSectionHelp = Optionally restrict the tracker to a subset of opportunity projects using a project category as a flag. Select "Track all projects" to disable additional filtering.
LeadtrackerFilterMode = Filter mode
LeadtrackerFilterAll = Track all projects
LeadtrackerFilterHasCategory = Track only projects with the selected category
LeadtrackerFilterNoCategory = Ignore projects with the selected category
LeadtrackerFilterCategory = Flag category
LeadtrackerFilterCategoryNone = (none)
LeadtrackerFilterNoCategoriesYet = No project categories found.
LeadtrackerGoToCategories = Create one →

# Display section
LeadtrackerDisplayOptions = Display
LeadtrackerDisplayMode = Display mode
LeadtrackerDisplayModeFull = Full (circles and labels)
LeadtrackerDisplayModeCompact = Compact (circles only)
LeadtrackerActionLinks = Show action link on current stage
LeadtrackerDebug = Debug output
LeadtrackerDebugHelp = Visible to administrators only.

# Colors
LeadtrackerColors = Colors (leave empty for theme default)
LeadtrackerColorComplete = Completed stage color
LeadtrackerColorCurrent = Current stage color
LeadtrackerColorPending = Pending stage color
LeadtrackerColorLost = Lost stage color
LeadtrackerColorHelp = Accepts a hex code (#2e7d32), a CSS color name, or rgb()/rgba().

# Auto-sync toggle
LeadtrackerAutoSyncOn = Auto-sync on
LeadtrackerAutoSyncOff = Manual override
LeadtrackerAutoSyncOnHelp = Amount and probability recalculate automatically on every document event. Click to lock for manual editing.
LeadtrackerAutoSyncOffHelp = Values are locked for manual editing. Click to re-enable automatic recalculation.
